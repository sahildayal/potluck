{
  "name": "potluck",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "pnpm -r test",
    "test:unit": "pnpm -r test:unit",
    "test:integration": "pnpm --filter @potluck/api test:integration",
    "db:generate": "pnpm --filter @potluck/api db:generate",
    "db:migrate": "pnpm --filter @potluck/api db:migrate",
    "deploy:pages": "VITE_API_URL= pnpm --filter @potluck/web build && wrangler pages deploy apps/web/dist --project-name potluck --branch main --commit-dirty=true"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  }
}
